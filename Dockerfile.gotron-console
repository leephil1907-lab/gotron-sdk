FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gotron-console ./app

FROM alpine:3.22
RUN addgroup -S app && adduser -S -G app app && apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/gotron-console /app/gotron-console
USER app
EXPOSE 8080
ENV LISTEN_ADDR=:8080
ENTRYPOINT ["/app/gotron-console"]
